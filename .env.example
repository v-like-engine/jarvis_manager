# Gerald Desktop Manager - Environment Variables
# Copy this file to .env and customize as needed

# Service Ports
ASR_SERVICE_PORT=8001
LLM_SERVICE_PORT=8002
COMMAND_SERVICE_PORT=8003

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR
LOG_DIR=logs

# ASR Configuration
ASR_SAMPLE_RATE=16000
ASR_VAD_THRESHOLD=0.5
ASR_CONFIDENCE_THRESHOLD=0.6

# LLM Configuration
LLM_MODEL=phi-3-mini
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=100

# Command Service
COMMAND_FUZZY_THRESHOLD=70
COMMAND_TERMINAL_TIMEOUT=30

# Performance
MAX_CPU_PERCENT=5
MAX_MEMORY_MB=4096

# Character
DEFAULT_CHARACTER=gerald
DEFAULT_LANGUAGE=en

# Privacy
STORE_USER_FEATURES=true
ENCRYPT_USER_DATA=false
